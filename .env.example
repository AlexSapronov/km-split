# Default on first start. Settings in the web UI override this value.
SPLIT_MODE=live
SPLIT_DATA=data
# No app login/password; CRPT authentication and signing require the employee's EDS.

# Private integration with gis-trueapi automatic GTD split workflow.
# Generate distinct random secrets for these variables; never commit .env.
SPLIT_INTERNAL_TOKEN=
SPLIT_SIGNER_TOKEN=
# Same certificate SHA-1 thumbprint used by marking-bm and gis-trueapi.
SPLIT_SIGNER_THUMBPRINT=
